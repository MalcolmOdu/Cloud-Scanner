DATABASE_URL=postgresql://scanner:scanner@localhost:5432/scanner

# Region the AWS clients are created in. Defaults to us-east-1 if unset.
AWS_REGION=us-east-1

# AWS credentials are NOT configured by this app. boto3 finds them itself through
# its default credential chain, e.g.:
#   - AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (/ AWS_SESSION_TOKEN) env vars
#   - AWS_PROFILE + ~/.aws/credentials and ~/.aws/config
#   - an IAM role (EC2 instance profile, ECS task role, etc.)
